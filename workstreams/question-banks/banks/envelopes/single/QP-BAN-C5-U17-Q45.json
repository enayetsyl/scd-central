    "answer_key": {
      "accepted": [
        "আড়াই হাজার বছরের প্রাচীন একটি দুর্গ-নগর পাওয়া যায়। সেখানে ছিল ইটের স্থাপত্য, বন্দর, রাস্তা ও গলি, পোড়ামাটির ফলক, মূল্যবান পাথর, পাথরের বাটখারা, কাচের পুঁতি ও মুদ্রাভান্ডার।"
      ],
      "model_note": "কয়েকটি নিদর্শনের নাম ঠিকভাবে লিখলেই পূর্ণ নম্বর; সবগুলো নাম লেখা জরুরি নয়।"
    }
