    "answer_key": {
      "accepted": [
        "সাল মিলিয়ে দেখলেই বোঝা যায়। ময়নামতিতে নগর গড়ে ওঠে সাত-আট শতকে আর মহাস্থানগড়ে তৃতীয় শতকের পরে, কিন্তু উয়ারী-বটেশ্বরে ধারণা করা হয় খ্রিষ্টপূর্ব ছয়-সাত শতকে — অর্থাৎ আরও অনেক আগে।"
      ],
      "model_note": "যুক্তিটি সালের তুলনা থেকেই আসতে হবে; কেবল 'পুরানো' বললে পূর্ণ নম্বর নয়।"
    }
